DROP PROCEDURE IF EXISTS `Club_GetTexasTableUserList`;
DELIMITER $$

CREATE PROCEDURE `Club_GetTexasTableUserList`(IN `sTableId` VARCHAR(100),IN `nBegin` INT,IN `nCnt` INT)
BEGIN
    DECLARE nAllCnt INT DEFAULT 0;

    SELECT COUNT(*)
    INTO nAllCnt
    FROM DJH_RecordDB.TexaTableUserStatistic
    WHERE TableId = sTableId;

    SELECT t.UserId, t.PlayCount, ROUND(IFNULL(SUM(u.LockGold), 0), 2) AS TakeInTotal, t.InPoolCount
            , COALESCE(w.WinLoseNew, 0) AS ProfitSum
            , COALESCE(w.PenaltySum, 0) AS nPenalty
            , COALESCE(w.RevenueSum, 0) AS nRevenue, t.Insurance
            , t.FaceID, t.NickName, nAllCnt AS AllCnt
    FROM DJH_RecordDB.TexaTableUserStatistic t
            LEFT JOIN (
                    SELECT TableId, UserId
                            , SUM(HandProfit) - SUM(InsureBuy) + SUM(InsureWin) AS WinLoseNew
                            , SUM(Penalty) AS PenaltySum, SUM(Revenue) AS RevenueSum
                    FROM DJH_RecordDB.PaiJuWinLoseRecord
                    WHERE TableId = sTableId
                    GROUP BY TableId, UserId
            ) w
            ON w.TableId = t.TableId
                    AND w.UserId = t.UserId

            LEFT JOIN DJH_RecordDB.UserLockGoldRecord u ON u.UserId = t.UserId AND u.TableId = t.TableId
    WHERE t.TableId = sTableId
    GROUP BY t.UserId, t.PlayCount, t.InPoolCount, COALESCE(w.WinLoseNew, 0), COALESCE(w.PenaltySum, 0), COALESCE(w.RevenueSum, 0), t.Insurance, t.FaceID, t.NickName
    ORDER BY COALESCE(w.WinLoseNew, 0) DESC
    LIMIT nBegin, nCnt;

END $$

DELIMITER ;